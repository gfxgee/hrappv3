APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ZKTeco biometric scanner. Set ZKTECO_SCANNER_SN to the official device's
# serial number to only sync scans from that device into attendance logs.
ZKTECO_SCANNER_SN=
ZKTECO_DEDUPE_MINUTES=3

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI (leave reason enhancement via Prism)
GEMINI_API_KEY=
AI_ENHANCE_PROVIDER=gemini
AI_ENHANCE_MODEL=gemini-2.5-flash

# GIF picker for praise-wall comments (provider: giphy or tenor)
GIF_PROVIDER=giphy
GIPHY_API_KEY=
TENOR_API_KEY=

# Microsoft / Azure AD SSO (Filament admin login)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/admin/auth/microsoft/callback"
MICROSOFT_TENANT_ID=common

# Microsoft Teams notifications via Power Automate (HTTP request trigger)
TEAMS_FLOW_URL=

# SharePoint "Timekeeping" mirror via Microsoft Graph (app-only / client
# credentials). May reuse the DF Portal's app registration credentials. Leave
# SHAREPOINT_TIMEKEEPING_ENABLED=false to use the local attendance_logs only.
SHAREPOINT_TIMEKEEPING_ENABLED=false
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TENANT_ID=
SHAREPOINT_SITE_ID=
SHAREPOINT_TIMEKEEPING_LIST=Timekeeping
SHAREPOINT_TIMEKEEPING_EMAIL_FIELD=Class
# Biometric/SharePoint attendance webhook shared secret (X-Webhook-Secret header)
BIOMETRIC_WEBHOOK_SECRET=DFCagayandeoro83!!!
